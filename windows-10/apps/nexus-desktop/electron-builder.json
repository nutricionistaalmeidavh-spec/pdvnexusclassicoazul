{
  "appId": "com.nexuscore.desktop",
  "productName": "Nexus Core",
  "electronVersion": "39.8.10",
  "npmRebuild": false,
  "directories": {
    "output": "dist-desktop"
  },
  "files": [
    "main.cjs",
    "preload.cjs",
    "package.json",
    {
      "from": "../meu-engenheiro/dist",
      "to": "meu-engenheiro/dist",
      "filter": ["**/*"]
    },
    {
      "from": "../pdv-demo/dist",
      "to": "pdv-demo/dist",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": ["nsis"]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
{
  "schemaVersion": 1,
  "systemId": "pdv-nexus",
  "mode": "electron",
  "defaultEnvironment": "local",
  "defaultFlow": "ui-review",
  "defaultViewport": "desktop",
  "launchTimeoutMs": 45000,
  "capture": {
    "video": false,
    "screenshotEachStep": false
  },
  "environments": {
    "local": {
      "env": {
        "NEXUS_APP": "pdv-demo"
      }
    }
  },
  "electron": {
    "entry": "../apps/nexus-desktop/main.cjs",
    "executablePath": "../node_modules/electron/dist/electron.exe",
    "env": {
      "NEXUS_APP": "pdv-demo"
    }
  },
  "flows": {
    "ui-review": "flows/ui-review.json",
    "batch-physical-tracking": "flows/batch-physical-tracking.json"
  }
}

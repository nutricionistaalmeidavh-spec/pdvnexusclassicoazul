{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@nexus-core/core": ["packages/core/src/index.ts"],
      "@nexus-core/database": ["packages/database/src/index.ts"],
      "@nexus-core/ui": ["packages/ui/src/index.tsx"],
      "@nexus-core/auth": ["packages/auth/src/index.ts"],
      "@nexus-core/ai-runtime": ["packages/ai-runtime/src/index.ts"],
      "@nexus-core/desktop-runtime": ["packages/desktop-runtime/src/index.ts"],
      "@nexus-core/module-ai": ["packages/modules/ai/src/index.ts"],
      "@nexus-core/module-balanca": ["packages/modules/balanca/src/index.ts"],
      "@nexus-core/module-crm": ["packages/modules/crm/src/index.ts"],
      "@nexus-core/module-dashboard": ["packages/modules/dashboard/src/index.ts"],
      "@nexus-core/module-documentos": ["packages/modules/documentos/src/index.ts"],
      "@nexus-core/module-financeiro": ["packages/modules/financeiro/src/index.ts"],
      "@nexus-core/module-oficina": ["packages/modules/oficina/src/index.ts"],
      "@nexus-core/module-aluguel-veiculo": ["packages/modules/aluguel-veiculo/src/index.ts"]
    }
  }
}
